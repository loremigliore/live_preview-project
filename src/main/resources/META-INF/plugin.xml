<idea-plugin>
<id>com.github.loremigliore.livepreview</id>
<name>Live Preview</name>
<vendor>loremigliore</vendor>

<depends>com.intellij.modules.platform</depends>
<depends>com.intellij.modules.kotlin.k2</depends>

<extensions defaultExtensionNs="com.intellij">

    <toolWindow
            id="LivePreview"
            factoryClass="com.github.loremigliore.livepreview.toolWindow.LivePreviewWindowFactory"
            icon="com.github.loremigliore.livepreview.icons.PluginIcons.ToolWindowIcon"
            anchor="right"
            order="after Notifications"
            doNotActivateOnStart="true"/>

    <applicationService
            serviceImplementation="com.github.loremigliore.livepreview.settings.LivePreviewSettings"/>

    <applicationConfigurable
            parentId="tools"
            id="visual.project.settings"
            instance="com.github.loremigliore.livepreview.settings.LivePreviewSettingsConfigurable"
            key="settings.display.name"
            bundle="messages.LivePreviewBundle"/>

    <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="com.github.loremigliore.livepreview.logic.PreviewLineMarkerProvider"/>

    <postStartupActivity implementation="com.github.loremigliore.livepreview.startup.LivePreviewStartupActivity"/>
</extensions>
    <projectListeners>
        <listener class="com.github.loremigliore.livepreview.listeners.KotlinFileOpenListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        
        <listener class="com.github.loremigliore.livepreview.listeners.PreviewHotReloadListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </projectListeners>
<resource-bundle>messages.LivePreviewBundle</resource-bundle>
</idea-plugin>